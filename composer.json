{
  "name": "threadi/easy-transients-for-wordpress",
  "version": "1.5.0",
  "description": "Provides a simple wrapper to handle transients in the WordPress-backend.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Thomas Zwirner",
      "email": "info@thomaszwirner.de"
    }
  ],
  "scripts": {
    "test": "phpunit",
    "test-install": "bash bin/install-wp-tests.sh wordpress_test root 'debian' 127.0.0.1 latest",
    "test-install-during-build": "bash bin/install-wp-tests.sh wordpress_test root 'debian' 127.0.0.1 latest false true",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse --memory-limit=1G"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "apcu-autoloader": true,
    "prepend-autoloader": false,
    "platform-check": false
  },
  "autoload": {
    "psr-4": {
      "easyTransientsForWordPress\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "easyTransientsForWordPress\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.4.1",
    "automattic/vipwpcs": "^3.1",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "yoast/phpunit-polyfills": "^1.0",
    "wp-phpunit/wp-phpunit": "^6.3"
  }
}
